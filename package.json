{
  "name": "docm",
  "version": "0.1.2",
  "description": "Markdown to PDF preview and rendering",
  "author": "John Marinelli",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "notices:prepare": "node scripts/prepare-notices.mjs",
    "package": "pnpm run build && pnpm run notices:prepare && electron-builder --mac --dir --arm64 --publish never --config.electronDist=node_modules/electron/dist",
    "package:linux": "pnpm run build && pnpm run notices:prepare && electron-builder --linux --dir --x64 --publish never --config.electronDist=node_modules/electron/dist",
    "smoke": "node scripts/smoke.mjs",
    "build:smoke": "node scripts/build-smoke.mjs",
    "package:smoke": "node scripts/smoke.mjs --packaged",
    "bootstrap:electron": "pnpm exec install-electron",
    "formula:build": "node scripts/build-formula.mjs",
    "formula:prepare": "node scripts/prepare-formula.mjs && node scripts/homebrew.mjs prepare",
    "formula:install": "node scripts/homebrew.mjs install",
    "formula:refresh": "node scripts/prepare-formula.mjs && node scripts/homebrew.mjs refresh",
    "formula:smoke": "node scripts/homebrew.mjs smoke",
    "release:version": "node scripts/version.mjs bump",
    "release:check": "node scripts/version.mjs check-tag",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:merge": "node scripts/release.mjs merge",
    "release:smoke": "node scripts/release-smoke.mjs source",
    "release:homebrew": "node scripts/release-smoke.mjs homebrew",
    "release:github": "node scripts/release-github.mjs"
  },
  "build": {
    "appId": "local.docm",
    "productName": "Docm",
    "asar": true,
    "npmRebuild": false,
    "beforePack": "scripts/before-pack.mjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "extraResources": [
      {
        "from": ".build/third-party-notices",
        "to": "third-party-notices"
      },
      {
        "from": "bin/docm",
        "to": "bin/docm"
      }
    ],
    "mac": {
      "identity": "-",
      "extendInfo": {
        "CFBundleExecutable": "docm"
      },
      "notarize": false,
      "timestamp": "none",
      "hardenedRuntime": false,
      "category": "public.app-category.productivity"
    },
    "linux": {
      "executableName": "docm",
      "category": "Office"
    }
  },
  "dependencies": {
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/source-sans-3": "^5.3.1",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "dompurify": "^3.4.17",
    "github-slugger": "^2.0.0",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "5.4.394",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "smol-toml": "^1.9.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/dompurify": "^3.2.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-types": "^2.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
