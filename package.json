{
  "name": "docm",
  "version": "0.1.2",
  "description": "Markdown to PDF preview and rendering",
  "author": "John Marinelli",
  "license": "MIT",
  "homepage": "https://github.com/john-marinelli/docm",
  "desktopName": "docm.desktop",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "notices:prepare": "node scripts/prepare-notices.mjs",
    "package": "pnpm run build && pnpm run notices:prepare && electron-builder --publish never --config.electronDist=node_modules/electron/dist",
    "smoke": "node scripts/smoke.mjs",
    "package:smoke": "node scripts/smoke.mjs --packaged",
    "bootstrap:electron": "pnpm exec install-electron",
    "formula": "node scripts/formula.mjs",
    "release:version": "npm version --no-git-tag-version"
  },
  "build": {
    "appId": "local.docm",
    "productName": "Docm",
    "asar": true,
    "npmRebuild": false,
    "beforePack": "scripts/before-pack.mjs",
    "afterPack": "scripts/after-pack.mjs",
    "directories": {
      "output": "dist"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer"
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "extraResources": [
      {
        "from": ".build/third-party-notices",
        "to": "third-party-notices"
      },
      {
        "from": "bin/docm",
        "to": "bin/docm"
      }
    ],
    "mac": {
      "identity": "-",
      "extendInfo": {
        "CFBundleExecutable": "docm"
      },
      "notarize": false,
      "timestamp": "none",
      "hardenedRuntime": false,
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "tar.gz",
          "arch": "arm64"
        }
      ],
      "artifactName": "docm-${version}-darwin-arm64.${ext}"
    },
    "linux": {
      "executableName": "docm",
      "executableArgs": [
        "%f"
      ],
      "category": "Office",
      "maintainer": "John Marinelli",
      "target": [
        {
          "target": "tar.gz",
          "arch": "x64"
        },
        {
          "target": "deb",
          "arch": "x64"
        },
        {
          "target": "rpm",
          "arch": "x64"
        }
      ],
      "artifactName": "docm-${version}-linux-x64.${ext}"
    },
    "deb": {
      "afterInstall": "packaging/linux/after-install.tpl",
      "afterRemove": "packaging/linux/after-remove.tpl",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnss3",
        "libasound2 | libasound2t64",
        "libgbm1",
        "libdrm2",
        "libatk-bridge2.0-0 | libatk-bridge2.0-0t64",
        "libx11-xcb1",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "libxrandr2",
        "xdg-utils"
      ]
    },
    "rpm": {
      "afterInstall": "packaging/linux/after-install.tpl",
      "afterRemove": "packaging/linux/after-remove.tpl",
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ],
      "depends": [
        "libgtk-3.so.0()(64bit)",
        "libnss3.so()(64bit)",
        "libasound.so.2()(64bit)",
        "libgbm.so.1()(64bit)",
        "libdrm.so.2()(64bit)",
        "libatk-bridge-2.0.so.0()(64bit)",
        "libX11-xcb.so.1()(64bit)",
        "libXcomposite.so.1()(64bit)",
        "libXdamage.so.1()(64bit)",
        "libXfixes.so.3()(64bit)",
        "libXrandr.so.2()(64bit)",
        "xdg-utils"
      ]
    }
  },
  "dependencies": {
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/source-sans-3": "^5.3.1",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "dompurify": "^3.4.17",
    "github-slugger": "^2.0.0",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "5.4.394",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "smol-toml": "^1.9.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/dompurify": "^3.2.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-types": "^2.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
